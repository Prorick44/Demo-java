import java.util.Scanner;

class Decinal_Binary
{
	public static void main(String[] args) 
	{
		Scanner sc= new Scanner(System.in);
		System.out.println("Enter a Decimal number");
		int n = sc.nextInt();
		String s = "";
		System.out.print("Its Binary is:- ");
		while (n!=0)
		{
			int d = n % 2;
			s = d + s ;
			n /= 2;
		}
		System.out.print(s);
	}
}
