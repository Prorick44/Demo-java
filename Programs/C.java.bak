import java.util.Scanner;
// Automorphic
class C 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int m = n;
		int sq_n = n * n;
		boolean flag = true;
		while (n != 0)
		{
			int d = n % 10;
			int e = sq_n % 10;
			if (d == e) {
				n = n / 10;
				sq_n = sq_n / 10;
			}
			else {
				flag = false;
				break;
			}
		}
		if (flag == false)
			System.out.println(m + " not an automorphic number.");
		else 
			System.out.println(m + " an automorphic number.");
	}
}
