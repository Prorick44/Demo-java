import java.util.Scanner;

class Prime_Range 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.println("Enter lower range:-");
		int m = sc.nextInt();
		System.out.println("Enter upper range:-");
		int n = sc.nextInt();
		System.out.print("The prime number:- ");
		for (int i=m;i<=n;i++)
		{
			boolean flag = true;
			for (int j=2;j<i/2;j++)
			{
				if (i%j == 0)
				{
					flag = false;
					break;
				}
			}
			if (flag)
				System.out.print(i + " ");
		}
	}
}
