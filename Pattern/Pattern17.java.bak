class Pattern17
{
	public static void main(String[] args) 
	{
		for (int i=1;i<=5;i++)
		{
			for (int j=1;j<=5;j++)
			{
				if ((j == i) || (i+j == 5 + 1) || (j == 3))
				{
					System.out.print("*");
				}
				else
				{
					System.out.print(" ");	
				}
			}
			System.out.println();
		}
	}
	
}
